#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

scripts/install/pip_packages "pip<23.2,>=21.3.1"
scripts/install/pip_packages setuptools wheel
scripts/install/pip_packages --requirement requirements_lint.txt
scripts/install/core

# Install the integration's own requirements (normally installed by Home Assistant at runtime)
scripts/install/pip_packages $(python3 -c 'import json;print(" ".join(json.load(open("custom_components/bitvavo/manifest.json"))["requirements"]))')

pre-commit install --config .github/pre-commit-config.yaml
