{
  "config": {
    "step": {
      "user": {
        "title": "Connect to Bitvavo",
        "description": "This integration requires an API key from Bitvavo with 'View' (read-only) permission. It never trades or withdraws.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]",
          "api_secret": "API secret"
        },
        "data_description": {
          "api_key": "Create an API key in the Bitvavo dashboard under Settings > API.",
          "api_secret": "The secret shown once when the API key was created."
        }
      },
      "markets": {
        "title": "Select the cryptocurrency markets",
        "description": "Select the markets that you would like to track.",
        "data": {
          "markets": "Markets"
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "Bitvavo rejected the API key. Enter a new API key and secret with 'View' permission.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]",
          "api_secret": "API secret"
        }
      },
      "reconfigure": {
        "title": "Select the cryptocurrency markets",
        "description": "Select the markets that you would like to track.",
        "data": {
          "markets": "Markets"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "show_empty_assets": "Show assets with zero value"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "ticker": {
        "name": "Ticker - {market}"
      },
      "change_24h": {
        "name": "Change 24h - {market}"
      },
      "balance": {
        "name": "Balance - {symbol}"
      },
      "open_orders": {
        "name": "Open Orders"
      },
      "total_asset_value": {
        "name": "Total Asset Value - {currency}"
      },
      "maker_fee": {
        "name": "Maker fee"
      },
      "taker_fee": {
        "name": "Taker fee"
      }
    }
  }
}
